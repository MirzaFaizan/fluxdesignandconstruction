{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxdesignandconstruction",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "routes": [
    { "pattern": "fluxdesignandconstruction.com", "custom_domain": true },
    { "pattern": "www.fluxdesignandconstruction.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
